# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Sub-clock and clockless circuit support for Hardcaml"
description:
  "Standard-cell-level building blocks for Hardcaml designs that work below or without a clock: liberty-driven cell instantiation, delay lines and time-to-digital converters, with the constraints and simulation needed to verify them."
authors: ["kasper0406"]
license: "MIT"
homepage: "https://github.com/kasper0406/hardcaml_clockless"
bug-reports: "https://github.com/kasper0406/hardcaml_clockless/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.1"}
  "hardcaml" {>= "v0.18~"}
  "ppx_hardcaml" {>= "v0.18~"}
  "ppx_jane" {>= "v0.18~"}
  "stdio"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kasper0406/hardcaml_clockless.git"
